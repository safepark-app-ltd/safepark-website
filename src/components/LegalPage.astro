---
// One of the three legal pages. They keep their old WordPress URLs and link to
// each other with the tab row at the top.
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME } from '../consts';

interface Props {
  id: 'privacy-policy' | 'cookie-policy' | 'terms-conditions';
}

const { id } = Astro.props;
const entry = await getEntry('legal', id);
if (!entry) throw new Error(`Missing legal page: ${id}`);
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);

const tabs = [
  { id: 'privacy-policy', label: 'Privacy policy' },
  { id: 'cookie-policy', label: 'Cookie policy' },
  { id: 'terms-conditions', label: 'Terms & conditions' },
];
---

<BaseLayout title={`${entry.data.title} | ${SITE_NAME}`} description={entry.data.description}>
  <section class="page-hero legal-hero">
    <div class="container">
      <nav aria-label="Legal pages" class="tabs">
        {
          tabs.map((t) => (
            <a href={`/${t.id}/`} aria-current={t.id === id ? 'page' : undefined}>
              {t.label}
            </a>
          ))
        }
      </nav>
      <h1>{entry.data.title}</h1>
      {
        entry.data.updated && (
          <p class="updated">
            Last updated:{' '}
            <time datetime={entry.data.updated.toISOString().slice(0, 10)}>
              {entry.data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          </p>
        )
      }
    </div>
  </section>

  <section class="body">
    <div class="container cols">
      <nav aria-label="On this page" class="toc">
        <div class="toc-title">On this page</div>
        <ul>
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.slug}`}>{s.text}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <article class="legal">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-hero { padding: 56px 0 48px; }
  .legal-hero h1 { font-size: clamp(34px, 4.2vw, 52px); margin-bottom: 10px; }
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .tabs a {
    padding: 6px 16px;
    border-radius: 16px;
    border: 1px solid rgba(26, 43, 128, 0.35);
    background: var(--sp-white);
    font-family: var(--sp-font-display);
    font-size: 15px;
    text-decoration: none;
  }
  .tabs a[aria-current='page'] { background: var(--sp-navy); border-color: var(--sp-navy); color: var(--sp-white); }
  .updated { margin: 0; color: var(--sp-text-muted); font-size: 15px; }

  .body { padding: 56px 0 var(--sp-section); }
  .cols { display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; }

  .toc { flex: 1 1 240px; border-left: 2px solid var(--sp-sky); padding-left: 20px; position: sticky; top: 108px; }
  .toc-title { font-family: var(--sp-font-display); font-size: 14px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sp-text-muted); margin-bottom: 10px; }
  .toc ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 15px; line-height: 1.4; }
  .toc a { text-decoration: none; }
  .toc a:hover { text-decoration: underline; }

  .legal { flex: 999 1 560px; min-width: 0; max-width: 760px; line-height: 1.7; color: rgba(0, 0, 0, 0.78); }
  .legal :global(h2) { font-size: 28px; line-height: 1.25; margin: 40px 0 12px; }
  .legal :global(h2:first-child) { margin-top: 0; }
  .legal :global(h3) { font-size: 21px; color: var(--sp-text); margin: 20px 0 6px; }
  .legal :global(p) { margin: 0 0 14px; }
  .legal :global(ul) { margin: 0 0 16px; padding-left: 22px; }
  .legal :global(li) { margin-bottom: 6px; }

  .legal :global(.defs) { margin: 0 0 16px; border-top: 1px solid rgba(0, 0, 0, 0.1); }
  .legal :global(.defs > div) { display: flex; flex-wrap: wrap; gap: 4px 20px; padding: 10px 0; border-bottom: 1px solid rgba(0, 0, 0, 0.1); }
  .legal :global(.defs dt) { flex: 0 0 150px; font-family: var(--sp-font-display); font-size: 17px; color: var(--sp-navy); }
  .legal :global(.defs dd) { flex: 1 1 300px; margin: 0; font-size: 16px; }

  .legal :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 16px; font-size: 16px; line-height: 1.5; }
  .legal :global(th) { text-align: left; font-family: var(--sp-font-display); font-weight: 400; font-size: 17px; color: var(--sp-navy); }
  .legal :global(th), .legal :global(td) { padding: 10px 16px 10px 0; vertical-align: top; border-bottom: 1px solid rgba(0, 0, 0, 0.1); overflow-wrap: anywhere; }
  .legal :global(th:last-child), .legal :global(td:last-child) { padding-right: 0; }

  .legal :global(.cookie) { background: var(--sp-page); border-radius: var(--sp-radius-card); padding: 18px 22px; margin: 0 0 16px; }
  .legal :global(.cookie h3) { margin-top: 0; font-size: 19px; color: var(--sp-navy); }
  .legal :global(.cookie dl) { margin: 0; font-size: 16px; }
  .legal :global(.cookie dl > div) { display: flex; flex-wrap: wrap; gap: 2px 16px; padding: 4px 0; }
  .legal :global(.cookie dt) { flex: 0 0 140px; font-weight: 500; color: var(--sp-text); }
  .legal :global(.cookie dd) { flex: 1 1 260px; margin: 0; }

  @media (max-width: 900px) {
    .toc { position: static; }
  }
  @media (max-width: 600px) {
    .legal-hero { padding: 36px 0 32px; }
    .body { padding-top: 32px; }
    .cols { gap: 32px; }
  }
</style>
