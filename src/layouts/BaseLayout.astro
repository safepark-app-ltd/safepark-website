---
import '@fontsource-variable/oswald';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import Header, { type NavId } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import favicon from '../assets/img/lock-lorry-symbol.png';
import logo from '../assets/img/SafeParkLogo4-with-TM.png';
import { DEFAULT_DESCRIPTION, EMAIL, PHONE, SITE_NAME } from '../consts';

interface Props {
  // Full <title>. Write it for search: what the page is, then "| SafePark".
  title: string;
  description?: string;
  current?: NavId;
  // 'article' for guides, so link previews show them as articles.
  ogType?: 'website' | 'article';
  // Extra JSON-LD for this page, merged into the graph.
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = DEFAULT_DESCRIPTION, current, ogType = 'website', schema = [], noindex = false } = Astro.props;

// Only the live site is indexed. The preview address must stay out of Google.
const isLive = Astro.site?.hostname === 'safepark.app';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const icon = await getImage({ src: favicon, width: 64, format: 'png' });
const appleIcon = await getImage({ src: favicon, width: 180, format: 'png' });
const logoImage = await getImage({ src: logo, width: 600, format: 'png' });

const graph = [
  {
    '@type': 'Organization',
    '@id': new URL('/#organization', Astro.site).href,
    name: SITE_NAME,
    url: new URL('/', Astro.site).href,
    logo: new URL(logoImage.src, Astro.site).href,
    telephone: '+44 1782 909489',
    email: EMAIL,
    contactPoint: { '@type': 'ContactPoint', telephone: PHONE, email: EMAIL, contactType: 'customer service', areaServed: 'GB' },
  },
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !isLive) && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="apple-touch-icon" href={appleIcon.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1a2b80" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
